library(sf)
library(dplyr)
library(readr)
library(ggplot2)
library(grid)
library(here)

slope_df <- read_csv(
  here("results", "LST_slope_and_Sen_slope_MO_2015_2024.csv"),
  show_col_types = FALSE
)

delta_df <- read_csv(
  here("results", "Delta_LST_NDVI_NDBI_MO_2015_2024.csv"),
  show_col_types = FALSE
)

mo <- st_read(
  here("data", "Mjesni_odbori_Zagreb", "Mjesni_odbori_Zagreb.shp"),
  quiet = TRUE
)

slope_mean <- mean(slope_df$slope, na.rm = TRUE)
sen_mean <- mean(slope_df$sen_slope, na.rm = TRUE)
dLST_mean <- mean(delta_df$dLST, na.rm = TRUE)

stability_df <- slope_df %>%
  left_join(
    delta_df %>% select(JMS_MB, dLST),
    by = "JMS_MB"
  ) %>%
  mutate(
    JMS_MB = as.character(JMS_MB),
    linear_positive = slope > 0,
    sen_positive = sen_slope > 0,
    delta_positive = dLST > 0,
    positive_indicators =
      as.integer(linear_positive) +
      as.integer(sen_positive) +
      as.integer(delta_positive),
    slope_above_mean = slope > slope_mean,
    sen_above_mean = sen_slope > sen_mean,
    dLST_above_mean = dLST > dLST_mean,
    above_mean_indicators =
      as.integer(slope_above_mean) +
      as.integer(sen_above_mean) +
      as.integer(dLST_above_mean),
    stability_class = case_when(
      positive_indicators == 3 & above_mean_indicators == 3 ~ "Strong stable",
      positive_indicators == 3 ~ "Stable",
      positive_indicators == 2 ~ "Moderate",
      TRUE ~ "Weak/inconsistent"
    ),
    stability_class = factor(
      stability_class,
      levels = c(
        "Weak/inconsistent",
        "Moderate",
        "Stable",
        "Strong stable"
      )
    )
  )

mo_stability <- mo %>%
  mutate(JMS_MB = as.character(JMS_MB)) %>%
  left_join(stability_df, by = "JMS_MB")

stability_colors <- c(
  "Weak/inconsistent" = "grey85",
  "Moderate" = "#fee08b",
  "Stable" = "#f46d43",
  "Strong stable" = "#b2182b"
)

p_stability <- ggplot(mo_stability) +
  geom_sf(
    aes(fill = stability_class),
    color = "white",
    linewidth = 0.18
  ) +
  scale_fill_manual(
    values = stability_colors,
    name = "Stability class",
    drop = FALSE,
    na.value = "grey95",
    guide = guide_legend(
      keyheight = unit(0.50, "cm"),
      keywidth = unit(0.50, "cm")
    )
  ) +
  coord_sf(datum = NA) +
  theme_void() +
  theme(
    legend.position = "right",
    legend.title = element_text(face = "bold", size = 12),
    legend.text = element_text(size = 11),
    legend.key = element_rect(fill = "white", color = NA),
    legend.background = element_rect(fill = "white", color = NA),
    plot.background = element_rect(fill = "white", color = NA)
  )

print(p_stability)

ggsave(
  filename = here("results", "LST_stability_magnitude_classification.png"),
  plot = p_stability,
  width = 150,
  height = 95,
  units = "mm",
  dpi = 300,
  bg = "white"
)

write_csv(
  stability_df,
  here("results", "LST_stability_classification_MO_2015_2024.csv")
)
